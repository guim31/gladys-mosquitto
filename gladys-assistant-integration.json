        "en": "Mosquitto: broker back",
        "fr": "Mosquitto : broker revenu",
        "de": "Mosquitto: Broker wieder da",
        "es": "Mosquitto: broker de vuelta"
      },
      "description": {
        "en": "The broker answers again after an outage of at least one minute.",
        "fr": "Le broker répond de nouveau après une coupure d'au moins une minute.",
        "de": "Der Broker antwortet wieder nach einem Ausfall von mindestens einer Minute.",
        "es": "El broker vuelve a responder tras una caída de al menos un minuto."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Broker",
            "fr": "Broker",
