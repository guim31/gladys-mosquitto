{
  "manifest_version": 1,
  "type": "device",
  "name": "Mosquitto",
  "description": {
    "en": "The health of your Mosquitto MQTT broker in Gladys: clients, message rates, uptime, outages.",
    "fr": "La santé de votre broker MQTT Mosquitto dans Gladys : clients, débit de messages, pannes.",
    "de": "Der Zustand deines Mosquitto-MQTT-Brokers in Gladys: Clients, Nachrichtenrate, Ausfälle.",
    "es": "La salud de su broker MQTT Mosquitto en Gladys: clientes, mensajes por minuto, caídas."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-mosquitto:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-mosquitto/main/cover.png",
  "categories": ["network"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Connect Mosquitto",
        "fr": "Connecter Mosquitto",
        "de": "Mosquitto verbinden",
        "es": "Conectar Mosquitto"
      },
      "description": {
        "en": "The integration reads the statistics Mosquitto publishes on $SYS/broker/#. It only subscribes, never publishes. The user needs read access to $SYS in the ACL file.",
        "fr": "L'intégration lit les statistiques que Mosquitto publie sur $SYS/broker/#. Elle s'abonne seulement, sans jamais publier. L'utilisateur doit pouvoir lire $SYS dans le fichier ACL.",
        "de": "Die Integration liest die Statistiken, die Mosquitto unter $SYS/broker/# veröffentlicht. Die Integration abonniert nur und veröffentlicht nie. Der Benutzer braucht in der ACL-Datei Lesezugriff auf $SYS.",
        "es": "La integración lee las estadísticas que Mosquitto publica en $SYS/broker/#. Solo se suscribe, nunca publica. El usuario necesita acceso de lectura a $SYS en el archivo ACL."
      },
      "links": [
        {
          "url": "https://mosquitto.org/man/mosquitto-8.html",
          "label": {
            "en": "The $SYS topics of Mosquitto",
            "fr": "Les sujets $SYS de Mosquitto",
            "de": "Die $SYS-Topics von Mosquitto",
            "es": "Los temas $SYS de Mosquitto"
          }
        }
      ]
    },
    {
      "key": "broker_url",
      "type": "string",
      "required": true,
      "label": {
        "en": "Broker address",
        "fr": "Adresse du broker",
        "de": "Adresse des Brokers",
        "es": "Dirección del broker"
      },
      "description": {
        "en": "mqtt:// (port 1883) or mqtts:// for TLS (port 8883). The broker installed by Gladys works too: its credentials are on the MQTT page of Gladys.",
        "fr": "mqtt:// (port 1883) ou mqtts:// pour TLS (port 8883). Le broker installé par Gladys convient aussi : ses identifiants sont sur la page MQTT de Gladys.",
        "de": "mqtt:// (Port 1883) oder mqtts:// für TLS (Port 8883). Der von Gladys installierte Broker geht auch: Seine Zugangsdaten stehen auf der MQTT-Seite von Gladys.",
        "es": "mqtt:// (puerto 1883) o mqtts:// para TLS (puerto 8883). El broker instalado por Gladys también sirve: sus credenciales están en la página MQTT de Gladys."
      },
      "placeholder": {
        "en": "e.g. mqtt://mosquitto.local:1883",
        "fr": "ex. mqtt://mosquitto.local:1883",
        "de": "z. B. mqtt://mosquitto.local:1883",
        "es": "p. ej. mqtt://mosquitto.local:1883"
      }
    },
    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "User name",
        "fr": "Nom d'utilisateur",
        "de": "Benutzername",
        "es": "Nombre de usuario"
      },
      "description": {
        "en": "Leave empty if the broker accepts anonymous clients.",
        "fr": "Laissez vide si le broker accepte les clients anonymes.",
        "de": "Leer lassen, wenn der Broker anonyme Clients zulässt.",
        "es": "Déjelo vacío si el broker acepta clientes anónimos."
      }
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe",
        "de": "Passwort",
        "es": "Contraseña"
      }
    },
    {
      "key": "tls_insecure",
      "type": "boolean",
      "default": false,
      "label": {
        "en": "Accept a self-signed certificate",
        "fr": "Accepter un certificat auto-signé",
        "de": "Selbstsigniertes Zertifikat akzeptieren",
        "es": "Aceptar un certificado autofirmado"
      },
      "description": {
        "en": "mqtts:// only: the certificate of the broker is then not checked.",
        "fr": "mqtts:// seulement : le certificat du broker n'est alors pas vérifié.",
        "de": "Nur mqtts://: Das Zertifikat des Brokers wird dann nicht geprüft.",
        "es": "Solo mqtts://: el certificado del broker no se comprueba."
      }
    },
    {
      "key": "language",
      "type": "select",
      "default": "fr",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Feature names of the broker when it is added, scene sentences and action messages.",
        "fr": "Noms des fonctionnalités du broker à son ajout, phrases des scènes et messages des actions.",
        "de": "Namen der Funktionen des Brokers beim Hinzufügen, Szenen-Sätze und Meldungen der Aktionen.",
        "es": "Nombres de las funciones del broker al añadirlo, frases de escenas y mensajes de las acciones."
      },
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "check_connection",
      "timeout_seconds": 10,
      "label": {
        "en": "Check the connection",
        "fr": "Vérifier la connexion",
        "de": "Verbindung prüfen",
        "es": "Comprobar la conexión"
      },
      "description": {
        "en": "Tells whether the broker answers and lets the user read $SYS, with its version and key numbers.",
        "fr": "Indique si le broker répond et laisse l'utilisateur lire $SYS, avec sa version et ses chiffres clés.",
        "de": "Zeigt, ob der Broker antwortet und dem Benutzer $SYS zu lesen erlaubt, mit Version und Kennzahlen.",
        "es": "Indica si el broker responde y permite al usuario leer $SYS, con su versión y sus cifras clave."
      }
    }
  ],
  "scene_triggers": [
    {
      "key": "broker_unreachable",
      "label": {
        "en": "Mosquitto: broker unreachable",
        "fr": "Mosquitto : broker injoignable",
        "de": "Mosquitto: Broker nicht erreichbar",
        "es": "Mosquitto: broker inaccesible"
      },
      "description": {
        "en": "The broker has been unreachable for the chosen time. A restart of a few seconds fires nothing.",
        "fr": "Le broker est injoignable depuis la durée choisie. Un redémarrage de quelques secondes ne déclenche rien.",
        "de": "Der Broker ist seit der gewählten Dauer nicht erreichbar. Ein Neustart von wenigen Sekunden löst nichts aus.",
        "es": "El broker está inaccesible desde hace el tiempo elegido. Un reinicio de unos segundos no activa nada."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Broker",
            "fr": "Broker",
            "de": "Broker",
            "es": "Broker"
          }
        },
